{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build-assets.mjs",
        "build:ssr": "node scripts/build-assets.mjs && node scripts/build-assets.mjs --ssr",
        "build:ssr:production": "node scripts/build-assets.mjs && node scripts/build-assets.mjs --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint resources/js scripts eslint.config.js vite.config.ts --ext .js,.jsx,.ts,.tsx,.mjs --fix",
        "lint:check": "eslint resources/js scripts eslint.config.js vite.config.ts --ext .js,.jsx,.ts,.tsx,.mjs",
        "co-browse:guard": "node scripts/check-co-browse-guard.mjs",
        "browser:smoke": "node scripts/browser-smoke.mjs",
        "browser:e2e": "node scripts/browser-smoke.mjs",
        "wayfinder:generate": "php artisan wayfinder:generate --with-form && node scripts/clean-wayfinder-whitespace.mjs && node scripts/clean-wayfinder-whitespace.mjs",
        "screen-share:guard": "node scripts/check-screen-share-guard.mjs",
        "types:check": "tsc --noEmit",
        "quality:phpstan-baseline": "php scripts/assert-phpstan-baseline.php",
        "quality:monoliths": "php scripts/assert-monolith-size.php",
        "quality:production-monoliths": "php scripts/assert-monolith-size.php --production",
        "quality:ssr-locales": "node scripts/assert-explicit-intl-locales.mjs",
        "test:client-contracts": "tsx --test resources/js/**/*.test.ts resources/js/**/*.test.tsx"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "axe-core": "^4.13.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "otplib": "^13.5.0",
        "pixelmatch": "^7.2.0",
        "pngjs": "^7.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tsx": "^4.23.12",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@headlessui/react": "^2.2.0",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@stripe/stripe-js": "^9.8.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "input-otp": "^1.4.2",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^0.475.0",
        "puppeteer": "^25.0.4",
        "pusher-js": "^8.5.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "shell-quote": "^1.8.5",
        "js-yaml": "4.3.1",
        "minimatch@3": {
            "brace-expansion": "1.1.18"
        },
        "minimatch@10": {
            "brace-expansion": "5.0.9"
        }
    }
}
